# DevGuard AI — backend environment.
# Copy to .env and fill in. Never commit .env itself.
#
#   cp .env.example .env

# ---- Required for live scans -------------------------------------------------
# Groq API key. Get one at https://console.groq.com/keys
# The backend now imports and boots WITHOUT this set — every endpoint that does
# not call an LLM works fine. It is required only when you run an actual scan.
GROQ_API_KEY=

# ---- Server ------------------------------------------------------------------
# Port the backend listens on. Must match NEXT_PUBLIC_API_BASE in the frontend
# and the published port in docker-compose.yml.
PORT=8000

# ---- Cache (optional) --------------------------------------------------------
# Redis is optional. When it is unreachable the backend runs CACHE-LESS — every
# scan re-runs the pipeline. There is no in-process fallback cache; this line
# used to claim there was one. Scans still work, they just cost a full pipeline
# run every time (`backend/core/cache.py` fails open by design: a cache outage
# degrades to slower, never to broken).
#
# Under docker compose this is redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0

# ---- OpenTelemetry / SigNoz (optional) ---------------------------------------
# Where to export traces, metrics and logs. Leave unset to run without a
# collector — telemetry is fail-safe and a scan never depends on it.
#   local collector (docker compose --profile obs):  http://localhost:4317
#   SigNoz Cloud:                                    https://ingest.<region>.signoz.cloud:443
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=devguard-backend

# For SigNoz Cloud only — the ingestion key header.
# OTEL_EXPORTER_OTLP_HEADERS=signoz-access-token=<your-ingestion-key>

# Set to true to disable telemetry export entirely (useful for tests/CI).
# OTEL_SDK_DISABLED=true

# ---- SigNoz MCP (optional) ---------------------------------------------------
# Base URL of the SigNoz MCP server used by the self-observation layer.
#
# DELIBERATELY LEFT UNSET — do not uncomment unless you actually run an MCP
# server at the address you set. This line previously shipped as
# `SIGNOZ_MCP_URL=http://localhost:8080`, so `cp .env.example .env` (the very
# first step of the README quickstart) flipped `mcp_client.is_configured()` to
# True and pointed the self-observation layer at a port nothing serves. That
# undoes the whole point of the unset default: an unconfigured MCP path reports
# itself as unconfigured, instead of as a live integration that happens to be
# failing.
#
# This integration is NOT verified against a real SigNoz MCP server — see
# backend/core/mcp_client.py and docs/MCP_DECISION.md. Real MCP is JSON-RPC 2.0;
# this adapter assumes an HTTP envelope. When it is unreachable the cost path
# falls back to an in-process estimate, reported with data_source
# "local_shadow", never "live". Check the current state with:
#     curl localhost:8000/telemetry-status
#
# SIGNOZ_MCP_URL=

# ---- Access control (optional) -----------------------------------------------
# Shared secrets for the endpoints that spend money and for the approval gate:
# POST /scan, /scan/zip, /scan/repository, /scan/{id}/approve, /scan/{id}/reject.
#
# DELIBERATELY LEFT UNSET. Unset means no authentication, which is what makes a
# clean clone work with no configuration — every quickstart in the README runs
# without a key. That also means an internet-facing instance with this unset is
# open to anyone who can reach it.
#
# Comma-separated. Each key must be at least 16 characters; shorter ones are
# refused at load rather than silently accepted, because a 4-character key reads
# as protection without being any. Send it as either header:
#     Authorization: Bearer <key>
#     X-API-Key: <key>
# Check which mode is live (never prints the key itself):
#     curl localhost:8000/slo-status | jq .access_control
#
# DEVGUARD_API_KEYS=

# Comma-separated CORS allowlist. Unset allows every origin.
# DEVGUARD_ALLOWED_ORIGINS=https://your-frontend.example.com

# Per-client cap on the scan endpoints. 0 disables the limiter.
# DEVGUARD_SCAN_RATE_LIMIT=20
# DEVGUARD_SCAN_RATE_WINDOW_S=60
