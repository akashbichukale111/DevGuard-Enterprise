# DevGuard V2 — pinned versions (documented server behaviour).
#
# "@latest on record day is not @latest on judge day." Every one of these is
# resolved, not floating, and must be echoed into every proof pack.
#
# TWO GENERATIONS ARE RECORDED HERE, on purpose.
#
# The v1.6.0 line is the stack the committed proof packs `d4-*`, `d5-*` and
# `d6-loop-*` were captured against. Deleting it would make those artifacts
# unreproducible and would quietly rewrite the history of how the findings in
# `docs/upstream/` were reached.
#
# The v1.7.0 line is the stack that was stood up, verified and driven end to end
# in the session recorded under `evidence/datahub-live/`, and is what a reviewer
# reproducing the project today will get from `datahub docker quickstart`.

# --- DataHub Core, CURRENT --------------------------------------------------
# VERIFIED by reading it back from the RUNNING instance
# (GET /config -> versions."acryldata/datahub"), not from documentation.
# Evidence: evidence/datahub-live/01-service-verification.md
# Images live under acryldata/, NOT linkedin/.
DATAHUB_VERSION=v1.7.0
DATAHUB_COMMIT=7f81ccbfe27b9acc947f5f600fcf9ddb72138a80

# Supporting images the v1.7.0 quickstart resolved to, read from `docker ps`:
DATAHUB_MYSQL_VERSION=8.2.0
DATAHUB_OPENSEARCH_VERSION=2.19.3
DATAHUB_KAFKA_VERSION=8.2.2

# --- DataHub Core, PRIOR (the committed proof packs) ------------------------
# VERIFIED 2026-07-31 the same way. Evidence: evidence/d0/datahub-config.json
DATAHUB_VERSION_PRIOR=v1.6.0
DATAHUB_COMMIT_PRIOR=059a36c0b035a6057de00114ccac0ea9003d6bc2

# --- MCP server -------------------------------------------------------------
# 0.6.0 is the pinned release on PyPI and satisfies the ">= v0.5.0 for mutation
# tools" requirement.
#
# The running server reports its own version as 3.4.6 over `initialize`, which
# does NOT match the package version. Both are recorded because both are true,
# and reconciling them silently would hide a fact about the deployment.
MCP_SERVER_VERSION=0.6.0
MCP_SERVER_REPORTED_VERSION=3.4.6
MCP_PROTOCOL_VERSION=2024-11-05

# --- Python SDK / CLI -------------------------------------------------------
# What the live session ran. `datahub version` reports the CLI; GMS reports
# `managedIngestion.defaultCliVersion: 1.7.0` for the matching train.
DATAHUB_SDK_VERSION=1.7.0
DATAHUB_CLI_VERSION=1.7.0
DATAHUB_SDK_VERSION_PRIOR=1.6.0.16
DATAHUB_CLI_VERSION_PRIOR=1.6.0.16

# --- Substrate --------------------------------------------------------------
# The transformation and warehouse versions the live ingestion ran with. dbt's
# version matters to the catalog: `manifest.json` carries a schema version, and
# the DataHub dbt source reads it.
DBT_CORE_VERSION=1.12.0
DBT_POSTGRES_VERSION=1.11.0
SUBSTRATE_POSTGRES_VERSION=16

# --- Skills -----------------------------------------------------------------
# The pinned environment says "pin the ref" — a branch name is not a pin. Resolve to a commit SHA
# when the skills are actually added.
DATAHUB_SKILLS_REF=

# --- Analytics Agent (NOT in the hero path; optional after Aug 8) -----------
DATAHUB_ANALYTICS_AGENT_VERSION=0.4.0
