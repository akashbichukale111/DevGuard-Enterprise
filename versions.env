# DevGuard V2 — pinned versions (documented server behaviour).
#
# "@latest on record day is not @latest on judge day." Every one of these is
# resolved, not floating, and must be echoed into every proof pack.
#
# RESOLVED 2026-07-31 (D0) against the live indexes. Availability was verified;
# NOTHING here has been run yet — D0 stops before the stack is stood up.

# --- DataHub Core -----------------------------------------------------------
# VERIFIED 2026-07-31 by reading it back from the RUNNING instance
# (GET /config -> versions."acryldata/datahub"), not from documentation.
# Evidence: evidence/d0/datahub-config.json
# Images live under acryldata/, NOT linkedin/.
DATAHUB_VERSION=v1.6.0
DATAHUB_COMMIT=059a36c0b035a6057de00114ccac0ea9003d6bc2

# --- MCP server -------------------------------------------------------------
# 0.6.0 is the current release on PyPI and satisfies the ">= v0.5.0 for mutation
# tools" requirement.
MCP_SERVER_VERSION=0.6.0

# --- Python SDK / CLI -------------------------------------------------------
# datahub-agent-context and acryl-datahub share the 1.6.0.16 train.
DATAHUB_SDK_VERSION=1.6.0.16
DATAHUB_CLI_VERSION=1.6.0.16

# --- Skills -----------------------------------------------------------------
# The pinned environment says "pin the ref" — a branch name is not a pin. Resolve to a commit SHA
# when the skills are actually added.
DATAHUB_SKILLS_REF=

# --- Analytics Agent (NOT in the hero path; optional after Aug 8) -----------
DATAHUB_ANALYTICS_AGENT_VERSION=0.4.0
