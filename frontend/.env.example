# DevGuard AI — frontend environment.
# Copy to .env.local and adjust. Never commit .env.local.
#
#   cp .env.example .env.local

# Base URL of the DevGuard backend. Must match the backend's PORT and the
# published port in docker-compose.yml.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Kept for backwards compatibility — some routes read API_URL rather than
# API_BASE. Point both at the same host.
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket base for live scan streaming. Same host, ws:// or wss://.
NEXT_PUBLIC_WS_BASE=ws://localhost:8000

# SigNoz UI base, used to deep-link "Investigate in SigNoz" from a scan result.
# Leave unset if you are not running SigNoz — the link is then genuinely not
# shown (app/result/page.tsx gates the CTA on this variable). It used to fall
# back to https://cloud.signoz.io, so the button always rendered and opened a
# /trace/<id> path on SigNoz's own site, which 404s.
#
# Commented out because nothing serves localhost:3301 on a fresh checkout —
# set it to your own SigNoz UI to enable the deep link.
# NEXT_PUBLIC_SIGNOZ_URL=http://localhost:3301
