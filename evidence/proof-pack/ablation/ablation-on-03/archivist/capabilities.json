    "list_schema_fields": {
      "additionalProperties": false,
      "properties": {
        "urn": {
          "type": "string",
          "description": "Dataset URN"
        },
        "keywords": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional list of keywords to filter schema fields (OR matching).\n     - Single keyword: Treated as one keyword (NOT split on whitespace). Use for field names or exact phrases.\n     - Multiple keywords: Multiple keywords, matches any (OR logic).\n     - None or empty list: Returns all fields in priority order (same as get_entities).\n     Matches against fieldPath, description, label, tags, and glossary terms.\n     Matching fields are returned first, sorted by match count."
        },
        "limit": {
          "default": 100,
          "type": "integer",
          "description": "Maximum number of fields to return (default: 100)"
        },
        "offset": {
          "default": 0,
          "type": "integer",
          "description": "Number of fields to skip for pagination (default: 0)"
        }
