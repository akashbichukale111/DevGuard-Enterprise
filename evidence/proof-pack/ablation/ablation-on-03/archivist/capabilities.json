        },
        "target_urn": {
          "type": "string",
          "description": "URN of the target dataset"
        },
        "source_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional column name in source dataset"
        },
        "target_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional column name in target dataset (required if source_column provided)"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "upstream",
                "downstream"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional direction to search. If None (default), automatically discovers\n      the path by trying downstream first, then upstream. Specify \"downstream\" or\n      \"upstream\" explicitly for better performance if you know the direction."
        }
      },
      "required": [
        "source_urn",
        "target_urn"
      ],
      "type": "object"
    },
