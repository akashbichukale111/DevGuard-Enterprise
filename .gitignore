# Static export of the Command Center — a build artifact of `make replay-build`.
frontend/out/

# Replay bundles, generated from the committed proof packs by `make replay`.
# Deliberately NOT committed: they are a second copy of evidence that is already
# in the repository, and a committed copy is one that can silently drift from
# the pack it claims to render.
frontend/public/replay/

# OTLP verification artifact, regenerated by scripts/verify_otel.py.
docs/verification/
