+++ b/datahub-graphql-core/src/main/java/com/linkedin/datahub/graphql/resolvers/incident/UpdateIncidentStatusResolver.java
@@ -17,7 +17,7 @@ import com.linkedin.datahub.graphql.concurrency.GraphQLConcurrencyUtils;
