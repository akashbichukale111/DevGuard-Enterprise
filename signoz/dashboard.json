    {
      "id": "panel-cache-ratio",
      "title": "Cache Hit Ratio",
      "description": "Formula F1 = hits / (hits + misses) from devguard_cache_hit_total and devguard_cache_miss_total. A healthy repeat-scan workload (e.g. CI re-scanning the same PR) should trend toward a high ratio; a sudden drop to ~0 usually means Redis is down and we've correctly failed OPEN to cache-less operation.",
      "panelTypes": "value",
      "yAxisUnit": "percentunit",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "expression": "A",
              "legend": "hits",
              "dataSource": "metrics",
              "aggregateOperator": "increase",
              "timeAggregation": "increase",
              "spaceAggregation": "sum",
              "aggregateAttribute": {
                "key": "devguard.cache.hit_total",
                "type": "Sum",
                "dataType": "float64",
                "isColumn": true
              },
              "filters": {
                "op": "AND",
                "items": []
              },
              "groupBy": [],
              "reduceTo": "sum",
              "disabled": true,
              "stepInterval": 60
            },
            {
              "queryName": "B",
              "expression": "B",
              "legend": "misses",
              "dataSource": "metrics",
              "aggregateOperator": "increase",
              "timeAggregation": "increase",
              "spaceAggregation": "sum",
              "aggregateAttribute": {
                "key": "devguard.cache.miss_total",
                "type": "Sum",
                "dataType": "float64",
                "isColumn": true
              },
              "filters": {
                "op": "AND",
                "items": []
              },
              "groupBy": [],
              "reduceTo": "sum",
              "disabled": true,
              "stepInterval": 60
            }
