{
  "title": "DevGuard AI — Observability & Resilience",
  "name": "devguard-observability",
  "description": "SRE dashboard for the DevGuard AI 3-agent pipeline. Panels: request latency (p50/p95/p99 + 3s SLO marker), cost per request, token usage over time, LLM error rate, circuit breaker state changes, cache hit ratio, and self-observation panels (adaptive routing overrides, postmortem triggers, RAG context-k adaptation, cumulative cost vs conservation threshold). Import via Dashboards -> Import JSON. All panels are driven by OTel metrics/spans emitted from backend/core/telemetry.py and backend/core/self_observer.py.",
  "tags": [
    "devguard",
    "llm",
    "sre",
    "resilience",
    "hackathon",
    "self-observation"
  ],
  "version": "v5",
  "uploadedGrafana": false,
  "collapsableRowsMigrated": true,
  "variables": {
    "env-var": {
      "id": "env-var",
      "name": "deployment_environment",
      "description": "Filter by deployment environment (production/staging).",
      "type": "QUERY",
      "queryValue": "SELECT DISTINCT JSONExtractString(labels, 'deployment_environment') AS env FROM signoz_metrics.distributed_time_series_v4_1day WHERE metric_name = 'devguard_scan_latency'",
      "customValue": "",
      "textboxValue": "",
      "multiSelect": false,
      "showALLOption": true,
      "sort": "ASC",
      "order": 0,
      "selectedValue": "production",
      "allSelected": false,
      "modificationUUID": "b2d1f0a0-0001-4a10-9c01-devguardenv01"
    }
  },
  "panelMap": {},
