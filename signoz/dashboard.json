  "widgets": [
    {
      "id": "panel-latency",
      "title": "Request Latency (p50 / p95 / p99)",
      "description": "End-to-end /scan latency percentiles from the devguard_scan_latency histogram. SLO objective line at 3000ms; sustained p99 above it burns the error budget (see /slo-status).",
      "panelTypes": "graph",
      "yAxisUnit": "ms",
      "thresholds": [
        {
          "index": "slo-3s",
          "keyIndex": 0,
          "thresholdValue": 3000,
          "thresholdUnit": "ms",
          "thresholdColor": "#F5222D",
          "thresholdLabel": "SLO: 3s objective",
          "thresholdOperator": ">",
          "thresholdFormat": "Text"
        }
      ],
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "expression": "A",
              "legend": "p50",
              "dataSource": "metrics",
              "aggregateOperator": "p50",
              "timeAggregation": "p50",
              "spaceAggregation": "p50",
              "aggregateAttribute": {
                "key": "devguard.scan.latency",
                "type": "Histogram",
                "dataType": "float64",
                "isColumn": true
              },
              "filters": {
                "op": "AND",
                "items": []
              },
              "groupBy": [],
              "reduceTo": "avg",
              "disabled": false,
              "stepInterval": 60
            },
            {
